# Runtime environment
SIGNBRIDGE_ENV=production
SIGNBRIDGE_PORT=8000

# Comma-separated browser origins. Set this to the public frontend URL in production.
SIGNBRIDGE_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SIGNBRIDGE_ENFORCE_WS_ORIGIN=true

# Resource limits
SIGNBRIDGE_MAX_TEXT_LENGTH=500
SIGNBRIDGE_MAX_WS_MESSAGE_BYTES=1600000
SIGNBRIDGE_MAX_FRAME_BYTES=1200000
SIGNBRIDGE_MAX_FRAME_WIDTH=1280
SIGNBRIDGE_MAX_FRAME_HEIGHT=720
SIGNBRIDGE_MAX_AUDIO_BYTES=4000000
SIGNBRIDGE_GESTURE_FRAME_INTERVAL=0.0667
SIGNBRIDGE_AVATAR_REQUEST_INTERVAL=0.35
